# Скопируй этот файл в .env и заполни своими ключами
# .env НЕ должен попадать в git (см. .gitignore)

# Нужен только если images.provider = huggingface в config.yaml
# Получить бесплатно: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# Нужен только если images.provider = fal в config.yaml
# fal.ai даёт бесплатные кредиты при регистрации
FAL_KEY=
